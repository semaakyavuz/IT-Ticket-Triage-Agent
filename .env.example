# Bu dosyayi .env olarak kopyala. .env commit edilmez.
#
# Local (varsayilan): ollama / ollama  -> key gerekmez
# Canli demo (Render): groq / gemini   -> iki ucretsiz key
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (local) --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Groq (canli demo LLM'i) - ucretsiz key: https://console.groq.com ------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GROQ_MAX_TOKENS=256

# --- Gemini (canli demo embedding'i) - ucretsiz key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- Depolama (calisma aninda uretilir, commit edilmez) ----------------------
SQLITE_DB_PATH=./data/tickets.db
CHROMA_PERSIST_DIR=./data/chroma

# --- Acilis / demo ---------------------------------------------------------
AUTO_INDEX=true
DEMO_SEED_HISTORY=false
RATE_LIMIT_PER_MINUTE=10
