# --- Sağlayıcı seçimi -------------------------------------------------------
# Local geliştirme (varsayılan): ollama / ollama  -> API key gerekmez
# Canlı demo (Hugging Face Spaces): groq / fastembed
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (local LLM) ----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Groq (canlı demo LLM'i, ücretsiz API key: https://console.groq.com) -----
# LLM_PROVIDER=groq iken zorunlu. Asla repoya commit etme.
GROQ_API_KEY=
# Ücretsiz katmanda erişilebilen, tool-calling'i tutarlı uygulayan model.
# (Llama 3.x ücretsiz katmanda yok; gpt-oss-120b RAG adımını atlayabiliyor.)
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen "düşünme" token'larını kapatır (gecikme 30 sn -> birkaç sn). Reasoning
# desteklemeyen bir modele geçersen boş bırak.
GROQ_REASONING_EFFORT=none

# --- Google Gemini embedding (canlı demo; ücretsiz key: https://aistudio.google.com/apikey)
# EMBEDDING_PROVIDER=gemini iken zorunlu. RAM harcamaz; 512 MB'lık ücretsiz
# sunucular için uygun. Seed embedding'leri repoda önbelleklidir
# (scripts/cache_seed_embeddings.py), API'ye sadece sorgular için gidilir.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- fastembed (sunucu içi, CPU, çok dilli embedding; ~350 MB RAM) ------------
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=./data/fastembed

# --- Depolama (çalışma anında üretilir, commit edilmez) ------------------------
SQLITE_DB_PATH=./data/tickets.db
CHROMA_PERSIST_DIR=./data/chroma
