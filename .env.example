# --- Sağlayıcı seçimi -------------------------------------------------------
# Local geliştirme (varsayılan): ollama / ollama  -> API key gerekmez
# Canlı demo (Hugging Face Spaces): groq / fastembed
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (local LLM) ----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Groq (canlı demo LLM'i, ücretsiz API key: https://console.groq.com) -----
# LLM_PROVIDER=groq iken zorunlu. Asla repoya commit etme.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- fastembed (sunucu içi, CPU, çok dilli embedding) -------------------------
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=./data/fastembed

# --- Depolama (çalışma anında üretilir, commit edilmez) ------------------------
SQLITE_DB_PATH=./data/tickets.db
CHROMA_PERSIST_DIR=./data/chroma
